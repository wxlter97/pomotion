# Token secreto de la integración interna de Notion.
# Se crea en https://www.notion.so/my-integrations y debe compartirse
# manualmente con la página índice y con cada página semanal (ver README).
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de la página índice PERMANENTE en Notion (nunca se archiva).
# Es el ID de 32 caracteres que aparece al final de la URL de esa página.
NOTION_INDEX_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional. ID de una página "raíz" que lista varios archivos (Trabajo,
# Casa, Hábitos, etc.), cada uno con su propia rotación de semanas — ver
# README, sección "Múltiples archivos". Sin esto, la app funciona en modo
# de un solo archivo (comportamiento de siempre, NOTION_INDEX_PAGE_ID de
# arriba), sin mostrar ningún selector.
# NOTION_FILES_INDEX_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contraseña compartida para entrar a la app (auth simple, sin usuarios).
APP_PASSWORD=changeme

# Opcional. Zona horaria usada para calcular "hoy"/"qué día es" y para
# formatear las horas de inicio/fin en los bloques de sesión que se
# escriben en Notion. Por defecto: America/El_Salvador.
# APP_TIMEZONE=America/El_Salvador


# --- Base de datos (Turso / libSQL) — migración en curso, ver ROADMAP.md ---
# turso db create pomotion
# turso db show --url pomotion   /   turso db tokens create pomotion
TURSO_DATABASE_URL=libsql://pomotion-xxxx.turso.io
TURSO_AUTH_TOKEN=xxxxxxxx
# Correr `npm run migrate` para crear/actualizar el schema.
# Para desarrollo local sin Turso podés usar un archivo:  TURSO_DATABASE_URL=file:local.db
