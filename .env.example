# --- Base de datos (Turso / libSQL) ---
# turso db create pomotion
# turso db show --url pomotion   /   turso db tokens create pomotion
TURSO_DATABASE_URL=libsql://pomotion-xxxx.turso.io
TURSO_AUTH_TOKEN=xxxxxxxx
# Correr `npm run migrate` para crear/actualizar el schema.
# Para desarrollo local sin Turso: TURSO_DATABASE_URL=file:local.db

# --- Login por Google (OAuth2 + PKCE) ---
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web).
# Redirect URI autorizada: ${APP_BASE_URL}/api/auth/google/callback
# (agregá también http://localhost:5173/api/auth/google/callback para dev).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# Origen público de la app, sin barra final. Dev: http://localhost:5173
APP_BASE_URL=http://localhost:5173
# Tu email de Google: se aprueba solo en el primer login y queda como admin.
# El resto de usuarios arranca pendiente (npm run approve -- <email>).
SEED_ADMIN_EMAIL=vos@gmail.com

# Opcional. Zona horaria para calcular "hoy"/"qué día es" y formatear las
# horas de inicio/fin de las sesiones. Por defecto: America/El_Salvador.
# APP_TIMEZONE=America/El_Salvador

# --- Pago único "quitar anuncios" (Wompi El Salvador) ---
# Crear una app propia para Pomotion en el panel de Wompi (App ID + API Secret).
# El webhook (por defecto ${APP_BASE_URL}/api/billing?webhook=1) se firma con
# el API Secret: la firma se valida contra el cuerpo crudo.
# WOMPI_CLIENT_ID=
# WOMPI_CLIENT_SECRET=
# Solo si el webhook va a otra URL que la de arriba.
# WOMPI_WEBHOOK_URL=
# Solo en sandbox: acepta avisos de pagos de prueba (EsProductiva = false).
# WOMPI_ACCEPT_TEST_PAYMENTS=false
# Precio en centavos de dólar (default 199 = $1.99). Si lo cambiás, actualizá
# también ADS_FREE_PRICE_LABEL en src/constants.ts.
# ADS_FREE_PRICE_CENTS=199

# --- Anuncios (Google AdSense; variables del FRONTEND, se leen en build) ---
# Sin estas dos, el bloque bajo el timer es un recuadro vacío y no carga nada.
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# VITE_ADSENSE_SLOT=1234567890
