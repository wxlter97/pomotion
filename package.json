{
  "name": "pomotion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx scripts/dev-api-server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:notion": "tsx scripts/migrate-notion-to-turso.ts",
    "approve": "tsx scripts/approve-user.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p api/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "ical.js": "^2.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.2.24",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  }
}
